+            "max_opposite_evidence_streak": self.max_opposite_streak,
+            "finding_codes": "|".join(sorted(self.finding_codes)),
+            "review_priority": review_priority,
+            "needs_review": review_priority in {"P1", "P2"},
+            "detail_file": self.detail_file,
+        }
