+def _monitor_candle_time(snapshot_time: datetime) -> datetime:
+    """Return the last completed 1m candle inside a completed 3m snapshot.
+
+    AutoTrades stores snapshot_time as the 3-minute candle start label. A
+    snapshot labelled 09:15 represents the completed [09:15, 09:18) candle,
+    so the last causally available 1-minute candle in that snapshot starts at
+    09:17.
+    """
+    snap = _naive_ist(snapshot_time)
+    if snap is None:
+        raise ReplayExecutionCandleError("REPLAY_MONITOR_SNAPSHOT_TIME_MISSING")
+    return snap.replace(second=0, microsecond=0) + timedelta(minutes=2)
+
+
+def _strict_1m_monitor_price(self: TradeMonitor, ut: Any, snapshot: Any) -> Decimal:
+    """Price one monitored trade from its persisted 1m instrument candle.
+
+    This is replay-only and intentionally bypasses snapshot.derivatives when
+    the selected replay price source is ``1m_candle``. Missing/invalid candles
+    remain explicit per-trade errors; there is no fallback.
+    """
+    del self
+    symbol = str(getattr(ut, "symbol", "") or "").strip().upper()
+    if not symbol:
+        raise ReplayExecutionCandleError("REPLAY_MONITOR_SYMBOL_MISSING")
+
+    snapshot_time = getattr(snapshot, "snapshot_time", None)
+    if not isinstance(snapshot_time, datetime):
+        raise ReplayExecutionCandleError(
+            f"REPLAY_MONITOR_SNAPSHOT_TIME_MISSING symbol={symbol}"
+        )
+
+    candle_time = _monitor_candle_time(snapshot_time)
+    candle = CandleSchema.fetch_candle(
+        symbol=symbol,
+        frequency=1,
+        candle_time=candle_time,
+    )
+    if candle is None:
+        logger.error(
+            "REPLAY_MONITOR_CANDLE_MISSING | symbol=%s snapshot_time=%s "
+            "required_candle_time=%s frequency=1",
+            symbol,
+            _naive_ist(snapshot_time),
+            candle_time,
+        )
+        raise ReplayExecutionCandleError(
+            "REPLAY_MONITOR_CANDLE_MISSING "
+            f"symbol={symbol} snapshot_time={_naive_ist(snapshot_time)} "
+            f"required_candle_time={candle_time} frequency=1"
+        )
+
+    px = Decimal(str(candle.close or 0))
+    if px <= 0:
+        logger.error(
+            "REPLAY_MONITOR_CANDLE_INVALID | symbol=%s snapshot_time=%s "
+            "candle_time=%s close=%s",
+            symbol,
+            _naive_ist(snapshot_time),
+            candle_time,
+            candle.close,
+        )
+        raise ReplayExecutionCandleError(
+            "REPLAY_MONITOR_CANDLE_INVALID "
+            f"symbol={symbol} snapshot_time={_naive_ist(snapshot_time)} "
+            f"candle_time={candle_time} close={candle.close}"
+        )
+
+    return px
+
